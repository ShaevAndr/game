PORT=3001
POSTGRES_URL=postgres://game:game@localhost:5432/game
MONGO_URL=mongodb://localhost:27017
MONGO_DB=elemental_tactics
REDIS_URL=redis://localhost:6379
# Префикс ключей кэша и очередей; разные установки должны использовать разные значения.
REDIS_NAMESPACE=game
WEB_ORIGIN=http://localhost:5173
# Docker Compose: порт интерфейса. WEB_ORIGIN выше используется для pnpm dev.
GAME_WEB_PORT=8088
