# Публичный адрес игры в Docker Compose
# Для запуска по статическому IP укажите этот IP в GAME_HOST. Для HTTP без порта в URL задайте GAME_WEB_PORT=80.
# Имя или IP сервера, который вводят в браузере. Указывайте без схемы, порта и пути.
GAME_HOST=localhost
# Порт на хосте. Docker направляет его на порт 80 контейнера с Nginx.
GAME_WEB_PORT=8088

# Основной сервер при локальном запуске через pnpm dev
# Порт API на хосте. В vite.config.ts прокси API и Socket.IO направлен на localhost:3001.
PORT=3001
# Адрес интерфейса Vite, разрешённый в CORS для REST и Socket.IO, включая схему и порт.
# В Docker Compose значение формируется из GAME_HOST и GAME_WEB_PORT.
WEB_ORIGIN=http://localhost:5173
# Строка подключения основного сервера к PostgreSQL для игровых данных.
POSTGRES_URL=postgres://game:game@localhost:5432/game
# Строка подключения основного сервера к MongoDB для игровых каталогов и архива боёв.
MONGO_URL=mongodb://localhost:27017
# Имя базы в MongoDB. В Docker Compose оно задано в compose.yaml.
MONGO_DB=elemental_tactics
# Адрес Redis для кэша, присутствия игроков и фоновых задач основного сервера.
REDIS_URL=redis://localhost:6379

# Сервис мира при локальном запуске вне Docker
# Локальный адрес, на котором слушает сервис мира. 127.0.0.1 доступен только с этой машины.
WORLD_HOST=127.0.0.1
# Порт внутреннего HTTP API сервиса мира.
WORLD_PORT=3002
# Адрес, по которому основной сервер обращается к HTTP API мира.
# Используйте доступный адрес (обычно 127.0.0.1) и порт из WORLD_PORT.
WORLD_URL=http://127.0.0.1:3002
# Строка подключения сервиса мира к PostgreSQL, где хранится схема world.
WORLD_POSTGRES_URL=postgres://game:game@localhost:5432/game
# Адрес RabbitMQ для обмена сообщениями основного сервера и сервиса мира.
RABBITMQ_URL=amqp://game:game@localhost:5672

# Общие настройки для Docker Compose и локального запуска
# Префикс ключей Redis и очередей BullMQ. Установки с общим Redis используют разные значения.
REDIS_NAMESPACE=game
# Пространство имён RabbitMQ. У основного сервера и сервиса мира одной установки оно совпадает.
RABBITMQ_NAMESPACE=game
# Общий секрет основного сервера и сервиса мира, минимум 32 байта. Храните только на сервере.
WORLD_SERVICE_TOKEN=
