PORT=3001
POSTGRES_URL=postgres://game:game@localhost:5432/game
MONGO_URL=mongodb://localhost:27017
MONGO_DB=elemental_tactics
REDIS_URL=redis://localhost:6379
# Префикс ключей кэша и очередей; разные установки должны использовать разные значения.
REDIS_NAMESPACE=game
WEB_ORIGIN=http://localhost:5173
# Docker Compose: порт интерфейса. WEB_ORIGIN выше используется для pnpm dev.
GAME_WEB_PORT=8088
# Внутренний сервис мира: локальный процесс слушает только loopback.
WORLD_PORT=3002
WORLD_HOST=127.0.0.1
WORLD_POSTGRES_URL=postgres://game:game@localhost:5432/game
# Обязательный отдельный ключ, минимум 32 байта; не передавать браузеру.
WORLD_SERVICE_TOKEN=
# Внутренний REST для чтения состояния и исходных манифестов.
WORLD_URL=http://127.0.0.1:3002
RABBITMQ_URL=amqp://game:game@localhost:5672
# Установки и интеграционные тесты используют разные пространства имён очередей.
RABBITMQ_NAMESPACE=game
