  },
  "dependencies": {
    "@game/core": "workspace:*", "@game/messaging": "workspace:*", "@nestjs/common": "^11.0.0", "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0", "dotenv": "^16.4.7", "kysely": "^0.28.0",
    "pg": "^8.13.1", "reflect-metadata": "^0.2.2", "rxjs": "^7.8.1", "zod": "^3.24.1"
  },
  "devDependencies": { "@types/express": "^5.0.0", "@types/pg": "^8.11.10", "tsx": "^4.19.2" }
}
