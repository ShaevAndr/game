{
  "name": "@game/world", "version": "0.1.0", "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts", "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json", "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --experimental-test-isolation=none tests/*.test.ts",
