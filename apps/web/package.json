    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.65.0",
    "tsx": "^4.19.2",
    "vite": "^6.1.0"
  }
}
