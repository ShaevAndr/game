{
  "name": "@game/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/main.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:migrations": "node --import tsx --test tests/migrations.integration.ts",
    "test:infrastructure": "node --import tsx --test tests/infrastructure.integration.ts"
  },
  "dependencies": {
    "@game/core": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "bullmq": "^5",
    "dotenv": "^16.4.7",
    "ioredis": "^5",
    "kysely": "^0.28.0",
    "mongodb": "^6.12.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.10",
    "socket.io-client": "^4",
    "tsx": "^4.19.2"
  }
}
